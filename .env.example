# Store Rating Platform - Root Environment Example
# Copy this file to backend/.env (or set backend environment variables)

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/store_rating_db

# Alternative individual DB connection parameters
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=store_rating_db

# Security & Tokens (Phase 4)
JWT_SECRET=replace_with_a_secure_random_secret_in_later_phases

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
