# Store Rating Platform - Environment Example
# Copy this file to backend/.env and populate with your own secure values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=store_rating_db

# Security
JWT_SECRET=
CORS_ORIGIN=http://localhost:5173

