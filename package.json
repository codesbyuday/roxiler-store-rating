{
  "name": "store-rating-platform",
  "version": "1.0.0",
  "description": "Store Rating Web Application - Full Stack Assessment",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "setup": "npm run setup --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

